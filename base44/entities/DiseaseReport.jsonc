{
  "name": "DiseaseReport",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Disease Name"
    },
    "slug": {
      "type": "string",
      "title": "URL Slug"
    },
    "category": {
      "type": "string",
      "enum": [
        "autoimmune",
        "neurological",
        "cardiovascular",
        "endocrine",
        "musculoskeletal",
        "gastrointestinal",
        "respiratory",
        "mental_health",
        "chronic_pain",
        "dysautonomia",
        "gynecological",
        "other"
      ],
      "title": "Category"
    },
    "summary": {
      "type": "string",
      "title": "Summary",
      "description": "1-2 sentence overview shown on cards"
    },
    "overview": {
      "type": "string",
      "title": "Overview",
      "description": "Extensive report (markdown)"
    },
    "symptoms": {
      "type": "string",
      "title": "Symptoms",
      "description": "Markdown"
    },
    "diagnosis": {
      "type": "string",
      "title": "Diagnosis",
      "description": "Markdown"
    },
    "treatments": {
      "type": "string",
      "title": "Treatments",
      "description": "Markdown"
    },
    "resources": {
      "type": "string",
      "title": "Medical Resources",
      "description": "Markdown with links to authoritative sources"
    },
    "doctors_guide": {
      "type": "string",
      "title": "Doctors to See",
      "description": "Markdown \u2014 which specialists to visit"
    },
    "advocacy_guide": {
      "type": "string",
      "title": "Self-Advocacy Guide",
      "description": "Markdown \u2014 how to advocate for yourself"
    },
    "conquer_plan": {
      "type": "string",
      "title": "Conquer Plan",
      "description": "Step-by-step action plan (markdown)"
    },
    "is_public": {
      "type": "boolean",
      "default": true,
      "title": "Public"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "title": "Sort Order"
    }
  },
  "required": [
    "name",
    "slug",
    "category",
    "summary",
    "overview"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}