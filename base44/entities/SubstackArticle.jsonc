{
  "name": "SubstackArticle",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "link": {
      "type": "string",
      "format": "uri",
      "title": "Substack URL"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "pub_date": {
      "type": "string",
      "title": "Publish Date"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "title": "Sort Order"
    }
  },
  "required": [
    "title",
    "link"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}