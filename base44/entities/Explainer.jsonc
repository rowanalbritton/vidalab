{
  "name": "Explainer",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "subtitle": {
      "type": "string",
      "title": "Subtitle"
    },
    "category": {
      "type": "string",
      "enum": [
        "cycle",
        "sleep",
        "mood",
        "nutrition",
        "movement",
        "stress",
        "hormones"
      ],
      "title": "Category"
    },
    "content": {
      "type": "string",
      "title": "Content",
      "description": "Educational article body (markdown supported)"
    },
    "read_time_minutes": {
      "type": "number",
      "minimum": 1,
      "maximum": 30,
      "title": "Read Time (minutes)"
    },
    "image_url": {
      "type": "string",
      "format": "uri",
      "title": "Cover Image URL"
    },
    "is_public": {
      "type": "boolean",
      "default": true,
      "title": "Public"
    },
    "is_vida_plus": {
      "type": "boolean",
      "default": false,
      "title": "Vida+ Only"
    }
  },
  "required": [
    "title",
    "subtitle",
    "category",
    "content",
    "read_time_minutes"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}