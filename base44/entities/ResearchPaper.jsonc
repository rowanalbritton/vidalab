{
  "name": "ResearchPaper",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "program": {
      "type": "string",
      "enum": [
        "AP Research",
        "AP Seminar"
      ],
      "title": "Program"
    },
    "year": {
      "type": "string",
      "title": "Year"
    },
    "abstract": {
      "type": "string",
      "title": "Abstract / Synopsis"
    },
    "file_url": {
      "type": "string",
      "format": "uri",
      "title": "Full Paper File URL"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "title": "Sort Order"
    }
  },
  "required": [
    "title",
    "abstract"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}