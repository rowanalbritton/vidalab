{
  "name": "HealthResource",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "category": {
      "type": "string",
      "enum": [
        "recipe",
        "exercise",
        "meditation",
        "supplement",
        "habit"
      ],
      "title": "Category"
    },
    "subcategory": {
      "type": "string",
      "title": "Subcategory"
    },
    "description": {
      "type": "string",
      "title": "Short Description"
    },
    "content": {
      "type": "string",
      "title": "Full Content",
      "description": "Markdown body with instructions, details"
    },
    "duration_minutes": {
      "type": "number",
      "title": "Duration (minutes)"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "gentle",
        "easy",
        "moderate",
        "advanced"
      ],
      "default": "easy",
      "title": "Difficulty"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Tags"
    },
    "citations": {
      "type": "string",
      "title": "Citations",
      "description": "Markdown with source links"
    },
    "is_public": {
      "type": "boolean",
      "default": true,
      "title": "Public"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "title": "Sort Order"
    }
  },
  "required": [
    "title",
    "category",
    "description",
    "content"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}