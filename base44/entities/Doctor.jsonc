{
  "name": "Doctor",
  "type": "object",
  "properties": {
    "practice_name": {
      "type": "string",
      "title": "Practice Name"
    },
    "specialty": {
      "type": "string",
      "title": "Specialty"
    },
    "category": {
      "type": "string",
      "enum": [
        "autoimmune",
        "neurological",
        "cardiovascular",
        "endocrine",
        "musculoskeletal",
        "gastrointestinal",
        "respiratory",
        "mental_health",
        "chronic_pain",
        "dysautonomia",
        "gynecological",
        "other"
      ],
      "title": "Category"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "email": {
      "type": "string",
      "format": "email",
      "title": "Email"
    },
    "address": {
      "type": "string",
      "title": "Address"
    },
    "city": {
      "type": "string",
      "title": "City"
    },
    "state": {
      "type": "string",
      "title": "State"
    },
    "zip_code": {
      "type": "string",
      "title": "ZIP Code"
    },
    "website": {
      "type": "string",
      "format": "uri",
      "title": "Website"
    },
    "accepting_new_patients": {
      "type": "boolean",
      "default": true,
      "title": "Accepting New Patients"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "title": "Sort Order"
    }
  },
  "required": [
    "practice_name",
    "specialty"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}